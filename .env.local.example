# Titan email (via NameSilo) SMTP credentials.
# Copy this file to .env.local for local dev, and add the same variables
# in Netlify: Site settings → Environment variables.
# Host defaults to smtp.titan.email (465 SSL, then 587 STARTTLS fallback).
# Titan 535 usually means wrong mailbox password — use the full address as
# username and the mailbox (or Titan app) password. Never commit real values.
TITAN_SMTP_USER=save@sitesinc.co
# Quote the value if it contains $ or # so local Next.js dotenv does not strip it.
TITAN_SMTP_PASS="your-titan-mailbox-password"
# Optional override:
# TITAN_SMTP_HOST=smtp.titan.email

# Where website build requests (and, only if SiteFlow is re-enabled, its orders) are forwarded.
SITE_NOTIFY_EMAIL=save@sitesinc.co

# Required to open /app on preview, staging, or production.
# Local `next dev` bound to a loopback host (127.0.0.1 / localhost / ::1) skips the
# token gate (NODE_ENV !== production, not Netlify). Any non-loopback Host still needs this.
# Missing this secret fails closed outside that loopback-dev bypass.
# Do not rely on the local-dev-only fallback on Netlify.
# Scope to Deploy Previews / Branch deploys only until launch.
# Generate a separate production-only token at launch — never reuse preview.
#
# If this variable is set (including this placeholder), factoryToken() never returns
# "local-dev-only". Typing that fallback is rejected as an invalid access token.
FACTORY_ACCESS_TOKEN=change-me-before-any-remote-deploy

# Lead/project store. Default: local JSON in development, Netlify Blobs on NETLIFY.
# SITESINC_STORE=local
# SITESINC_STORE=blobs

# Public site origin used in Stripe success/cancel URLs (optional).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Live $1,995 Stripe Payment Links (public URLs, not secrets). Defaults are the live
# SITESYNC links in lib/payment-links.ts. Override on staging if you need test links.
# Do not use the retired Pilot $747.50 Payment Links.
# NEXT_PUBLIC_STRIPE_LINK_START_DEPOSIT=https://buy.stripe.com/4gM7sL7z74T7aX38o2a3u05
# NEXT_PUBLIC_STRIPE_LINK_LAUNCH_BALANCE=https://buy.stripe.com/eVqdR9cTr1GV9SZ5bQa3u06
# NEXT_PUBLIC_STRIPE_LINK_FLAT=https://buy.stripe.com/14AcN56v385j7KR0VAa3u07
# NEXT_PUBLIC_STRIPE_LINK_MONITORING=https://buy.stripe.com/aFa28r8Db4T73uB0VAa3u08

# SiteFlow master switch. PAUSED by default (Path A: the public offer is only the $1,995 build,
# 50/50, plus optional $129/mo monitoring). Leave unset. With it off, /cart, /tools, /go/*,
# /api/checkout, /api/download/*, /api/stripe/webhook, /api/siteflow/* and /api/factory/siteflow* answer
# 404, ?ref= does nothing, and every setting below is ignored. Public /checkout still serves the
# $1,995 Payment Links. "true" re-enables SiteFlow product checkout (Tony's decision).
# SITEFLOW_ENABLED=

# SiteFlow (docs/siteflow.md). Optional Stripe Checkout for /checkout. If unset, orders are
# stored and emailed so you can send a payment link. Use a TEST key (sk_test_/rk_test_) until
# Tony approves go-live. The /app SiteFlow bay shows which mode is active.
# STRIPE_SECRET_KEY=sk_test_...
# Signing secret of the Stripe webhook endpoint (https://<site>/api/stripe/webhook), or the
# whsec_ printed by `stripe listen`. Comma-separate two values while rotating.
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, invoice.paid, charge.refunded, customer.subscription.deleted
# STRIPE_WEBHOOK_SECRET=whsec_...
# HMAC secret for signed download links (32+ random chars). Required on Netlify.
# DOWNLOAD_SIGNING_SECRET=
# DOWNLOAD_LINK_TTL_HOURS=72
# Partner referral cookie window and refund window (commissions approve after it).
# SITEFLOW_REF_WINDOW_DAYS=30
# SITEFLOW_REFUND_WINDOW_DAYS=30
# Set to "listed" to let search engines index /tools (otherwise noindex, not in nav/sitemap).
# SITEFLOW_TOOLS_PAGE=
# Outbound affiliate tracking templates (https, must contain {url} and/or {domain}).
# Unset = plain registrar link, still click-logged through /go.
# AFFILIATE_NAMECHEAP_URL_TEMPLATE=
# AFFILIATE_PORKBUN_URL_TEMPLATE=
# AFFILIATE_DYNADOT_URL_TEMPLATE=
# AFFILIATE_SPACESHIP_URL_TEMPLATE=

# Google Analytics 4. Defaults to G-0XHXXSSB1N (sitesinc.co) when unset.
# It only loads on sitesinc.co / www.sitesinc.co, never on localhost or
# deploy previews. See docs/analytics.md.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-0XHXXSSB1N

# Staging copy only (https://test.sitesinc.co). Leave unset on production.
# See docs/STAGING.md. When set to staging: noindex, [TEST] emails,
# separate blob store, production GA is not loaded.
# NEXT_PUBLIC_SITE_ENV=staging
# SITE_ENV=staging
# Optional staging-only GA property. If unset, staging loads no analytics.
# NEXT_PUBLIC_GA_STAGING_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional Search Console URL Inspection for the factory indexing workflow.
# Indexed is never assumed. Without both values, states stay submitted/not_submitted.
# GOOGLE_SEARCH_CONSOLE_SITE_URL=https://sitesinc.co/
# Optional manual override only. It expires after about an hour, so prefer the service account below.
# GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=ya29.optional-short-lived-token

# Service account for Search Console + GA4 (local only; never commit the key or put it on Netlify).
# Absolute path to the downloaded JSON key. Add its client_email to Search Console (property users)
# and to the GA4 property as Viewer. Tokens are minted and refreshed hourly in memory.
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=C:\Users\you\secrets\google-factory-key.json
# GA4 Data API: numeric property id (GA4 Admin > Property details), NOT the G- measurement id.
# Powers the sessions / key events card on /app/seo and the /app/website-data dashboard.
# GA4_PROPERTY_ID=123456789
